# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"


# Server-side Financial Datasets API key. Never expose this value to the browser.
FINANCIAL_DATASETS_API_KEY=
FINANCIAL_DATASETS_BASE_URL=https://api.financialdatasets.ai

# Server-owned autonomous paper runtime. Keep false until the quantitative strategy
# and restart/recovery behavior have been validated on your own deployment.
JARVIS_PAPER_AUTOSTART=false
JARVIS_PAPER_SYMBOL=BTC/USD
JARVIS_PAPER_INITIAL_CAPITAL=10000
JARVIS_PAPER_POLL_MS=1000
# Secret for runtime start/stop/status control endpoints. Never expose this to the browser.
JARVIS_CONTROL_TOKEN=


# PostgreSQL platform persistence. Optional while Jarvis is research/paper-only.
# For a local Docker stack, set POSTGRES_PASSWORD and use the DATABASE_URL below.
DATABASE_URL=postgresql://jarvis:CHANGE_ME@postgres:5432/jarvis_finance
POSTGRES_DB=jarvis_finance
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=CHANGE_ME
JARVIS_DB_AUTO_MIGRATE=true
JARVIS_DB_REQUIRED=false
JARVIS_DB_MAX_CONNECTIONS=8
JARVIS_DB_CONNECTION_TIMEOUT_MS=5000
JARVIS_DB_SSL=false
# JARVIS_DB_SSL_REJECT_UNAUTHORIZED=true


# Server-side Binance Spot Testnet account adapter.
# Keep these credentials off the client and out of Git. The adapter is testnet-only
# unless explicitly overridden for a future, separately reviewed phase.
JARVIS_BINANCE_TESTNET_API_KEY=
JARVIS_BINANCE_TESTNET_API_SECRET=
JARVIS_BINANCE_TESTNET_BASE_URL=https://testnet.binance.vision
JARVIS_BINANCE_TESTNET_ACCOUNT_ID=binance-testnet-local
JARVIS_BINANCE_TESTNET_ONLY=true
# Explicit second gate: order submission/cancel stays disabled unless this is true.
# Keep false for the read-only account phase.
JARVIS_BINANCE_TESTNET_ENABLE_ORDERS=false
JARVIS_BINANCE_RECV_WINDOW_MS=5000


# Authenticated Jarvis operator account.
# Required when JARVIS_AUTH_REQUIRED=true. Keep the password out of Git.
JARVIS_ADMIN_EMAIL=
JARVIS_ADMIN_DISPLAY_NAME=Jarvis Operator
JARVIS_ADMIN_PASSWORD=
JARVIS_ADMIN_RESET_PASSWORD=false
JARVIS_AUTH_REQUIRED=false
# In production behind HTTPS, set true. Development defaults to false.
JARVIS_SECURE_COOKIES=false

# Server-owned Binance Spot user-data stream. Default is on when testnet credentials are configured.
JARVIS_BINANCE_USER_STREAM_AUTOSTART=true
# REST reconciliation backstop for active sandbox orders (user stream remains primary).
JARVIS_BINANCE_RECONCILIATION_POLL_MS=15000

# Portfolio risk valuation base. Sandbox portfolio exposure gates fail closed when
# an asset/order cannot be valued in this base currency.
JARVIS_PORTFOLIO_BASE_CURRENCY=USDT
